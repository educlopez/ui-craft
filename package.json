{
  "name": "ui-craft-detect",
  "version": "0.13.0",
  "description": "Static anti-slop detector for UI code. Flags AI-generated design patterns (purple gradients, bounce easing, glassmorphism, generic CTAs, ALL CAPS headings, transition: all). Zero dependencies, works out of the box.",
  "type": "module",
  "bin": {
    "ui-craft-detect": "scripts/detect.mjs"
  },
  "main": "scripts/detect.mjs",
  "files": [
    "scripts/detect.mjs",
    "scripts/detect/",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "ui",
    "design",
    "linter",
    "detector",
    "anti-pattern",
    "ai-slop",
    "css",
    "jsx",
    "tsx",
    "tailwind",
    "accessibility",
    "design-system",
    "cli",
    "code-quality"
  ],
  "scripts": {
    "check:action-pins": "node scripts/check-action-pins.mjs",
    "check:deadcode": "node scripts/check-deadcode.mjs",
    "check:distribution": "node scripts/check-distribution-contract.mjs",
    "check:frontmatter": "node scripts/check-frontmatter-strict.mjs",
    "check:home-isolation": "node scripts/check-home-isolation.mjs",
    "check:mirrors": "node scripts/check-mirror-copies.mjs",
    "check:version-mentions": "node scripts/check-version-mentions.mjs",
    "check:release-assets": "node scripts/check-release-assets.mjs",
    "check:versions": "node scripts/check-versions-md.mjs",
    "detect": "node scripts/detect.mjs",
    "eval:build": "node scripts/eval-build.mjs",
    "sync": "node scripts/sync-mirrors.mjs",
    "test:evals": "node --test scripts/eval-build.test.mjs",
    "test:verify": "node --test scripts/check-distribution-contract.test.mjs scripts/verify.test.mjs scripts/check-versions-md.test.mjs",
    "validate": "node scripts/validate.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:list": "node scripts/verify.mjs --list"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/educlopez/ui-craft.git"
  },
  "homepage": "https://skills.smoothui.dev",
  "bugs": {
    "url": "https://github.com/educlopez/ui-craft/issues"
  },
  "author": "Eduardo Calvo",
  "license": "MIT"
}
