#!/bin/bash
# Pre-commit hook for ui-craft. Runs the anti-slop detector on any staged UI
# files.
#
# It used to also stamp a CalVer "version" into marketplace.json on every
# commit. That did nothing for users (plugin.json pinned "1.0.0", which Claude
# Code reads first) and made every two open PRs conflict. Neither manifest
# pins a version now, so Claude Code versions the plugin by commit SHA.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Temporarily skip (use sparingly):
#   git commit --no-verify

set -e

# --- Anti-slop detector on staged UI files -----------------------------

STAGED=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '\.(css|scss|sass|tsx|jsx|ts|js|vue|svelte|astro|html)$' || true)

if [ -z "$STAGED" ]; then
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
TMPDIR="$(mktemp -d)"
trap 'rm -rf "$TMPDIR"' EXIT

# Copy the staged version of each file (index content) into a temp tree so
# the detector sees exactly what's about to be committed — not the working
# tree, which may have unrelated unstaged edits.
while IFS= read -r file; do
  mkdir -p "$TMPDIR/$(dirname "$file")"
  git show ":$file" > "$TMPDIR/$file" 2>/dev/null || true
done <<< "$STAGED"

# Copy the repo config file so the detector respects .uicraftrc.json ignore patterns.
if [ -f "$REPO_ROOT/.uicraftrc.json" ]; then
  cp "$REPO_ROOT/.uicraftrc.json" "$TMPDIR/.uicraftrc.json"
fi

cd "$TMPDIR"
if node "$REPO_ROOT/scripts/detect.mjs" . ; then
  exit 0
else
  echo ""
  echo "ui-craft anti-slop detector found issues in staged files."
  echo "Fix them, re-stage, and commit again — or run 'git commit --no-verify'."
  exit 1
fi
