{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/educlopez/ui-craft/schemas/distribution-manifest.schema.json",
  "title": "ui-craft distribution manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "components",
    "compatibility",
    "pinnedLaunchers",
    "canonicalSources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "components": {
      "type": "object",
      "required": [
        "detector",
        "mcp",
        "cli",
        "claudePlugin",
        "marketplaceListing"
      ],
      "properties": {
        "detector": {
          "type": "object",
          "required": ["package", "version", "runtime", "contract"],
          "properties": {
            "package": { "type": "string" },
            "version": { "type": "string" },
            "runtime": { "type": "string" },
            "contract": { "type": "string" }
          },
          "additionalProperties": false
        },
        "mcp": {
          "type": "object",
          "required": ["package", "version", "invocation", "runtime", "contract"],
          "properties": {
            "package": { "type": "string" },
            "version": { "type": "string" },
            "invocation": { "type": "string" },
            "runtime": { "type": "string" },
            "contract": { "type": "string" }
          },
          "additionalProperties": false
        },
        "cli": {
          "type": "object",
          "required": ["binary", "compatibleReleaseLine", "runtime", "contract"],
          "properties": {
            "binary": { "type": "string" },
            "compatibleReleaseLine": { "type": "string" },
            "runtime": { "type": "string" },
            "contract": { "type": "string" }
          },
          "additionalProperties": false
        },
        "claudePlugin": {
          "type": "object",
          "required": ["name", "version", "contract"],
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" },
            "contract": { "type": "string" }
          },
          "additionalProperties": false
        },
        "marketplaceListing": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["consumer", "requires"],
        "properties": {
          "consumer": { "type": "string" },
          "requires": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "pinnedLaunchers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "format"],
        "properties": {
          "path": { "type": "string" },
          "format": {
            "type": "string"
          },
          "server": { "type": "string" },
          "symbol": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "canonicalSources": {
      "type": "object",
      "required": ["skills", "commands", "agents", "detector", "mcp"],
      "properties": {
        "skills": { "type": "string" },
        "commands": { "type": "string" },
        "agents": { "type": "string" },
        "detector": { "type": "string" },
        "mcp": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
